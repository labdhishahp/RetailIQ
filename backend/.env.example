# RetailIQ backend environment template
# Copy to .env and fill in DATABASE_URL:  cp .env.example .env
# Loaded by app/core/config.py. The path is anchored to this directory, so the
# server can be started from anywhere. Real environment variables always take
# precedence over this file — that is how deployment supplies configuration.

# --- REQUIRED ---------------------------------------------------------------
# Supabase PostgreSQL connection string (Project Settings -> Database).
# Use the transaction pooler on port 6543 — the right mode for serverless.
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Must use the postgresql:// scheme. Quote the value, and percent-encode the
# password if it contains @ : / ? # or %.
DATABASE_URL=

# --- SECURITY (set in production) -------------------------------------------
# Signing key for access/refresh tokens. If blank, a random key is generated at
# startup, which is fine locally but invalidates every token on restart.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Comma-separated allowed origins. "*" is acceptable for local development;
# set your deployed origin in production.
CORS_ORIGINS=*

# --- AI COPILOT (optional) ---------------------------------------------------
# With an Anthropic key the lead investigator and the specialists are
# model-driven: they choose tools, read the results and decide whether to dig
# further. Without one the same agents run on rule policies that also choose
# their next tool from what the previous one returned.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- PERFORMANCE -------------------------------------------------------------
# Seconds to cache analytics responses. 0 disables caching.
ANALYTICS_CACHE_SECONDS=60

# --- OPTIONAL (uvicorn CLI only; not read by app code) ----------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- OPTIONAL (read by app/main.py; these are already the defaults) ---------
# API_TITLE=RetailIQ API
# API_VERSION=0.1.0
# API_PREFIX=/api/v1
# DEBUG=false
