# Frontend environment template. Copy to .env only to override a default —
# the app works with no .env at all.

# Where the Vite dev server proxies /api requests (default shown).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only needed when the API is served from a DIFFERENT origin than the app.
# Leave unset for local development and for Vercel, where /api is same-origin.
# VITE_API_BASE_URL=
